# Copy this file to .env and adjust locally. Never commit .env.

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL will be a hosted database (for example Supabase) starting in the
# database milestone. Do not set a real password in this example file.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
