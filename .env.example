# Copy this file to .env and adjust locally. Never commit .env.

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Hosted PostgreSQL (for example Supabase).
# postgresql://USER:PASSWORD@HOST:5432/postgres
# postgresql:// is fine; the app uses the psycopg driver and adds SSL when needed.
# Leave special characters in the password as they are; do not paste real secrets here.
DATABASE_URL=

# Dedicated database for pytest. Do not point this at real business data.
# Tests create and drop application tables.
TEST_DATABASE_URL=

# Synthetic demo seeder (optional). Local PostgreSQL only.
# The seeder refuses any host that is not loopback, and any database name
# that does not contain "demo" or "test". Never point this at MAIN.
# ALLOW_DEMO_SEED=1
# DEMO_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/sco_demo
